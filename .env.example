# Local development (SQLite file). Used by `prisma generate`, `prisma db push`,
# and by the app/scripts when the Turso vars below are NOT set.
DATABASE_URL="file:./dev.db"

# Production (Turso / libSQL). When TURSO_DATABASE_URL is set, the app and the
# ingest/rate scripts talk to Turso instead of the local file.
#   TURSO_DATABASE_URL: from `turso db show <db> --url`  (libsql://...)
#   TURSO_AUTH_TOKEN:   from `turso db tokens create <db>`
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-token"
